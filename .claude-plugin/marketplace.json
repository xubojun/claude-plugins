{
  "name": "xubojun-plugins",
  "owner": {
    "name": "xubojun"
  },
  "metadata": {
    "description": "補足官方 marketplace 尚未提供的 Claude Code 插件"
  },
  "plugins": [
    {
      "name": "dart-lsp",
      "description": "Dart/Flutter 語言伺服器：型別檢查、診斷、跳轉定義與尋找引用",
      "version": "1.0.0",
      "author": {
        "name": "xubojun"
      },
      "source": "./plugins/dart-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "dart": {
          "command": "dart",
          "args": [
            "language-server",
            "--protocol=lsp"
          ],
          "extensionToLanguage": {
            ".dart": "dart"
          }
        }
      },
      "license": "MIT",
      "repository": "https://github.com/xubojun/claude-plugins"
    }
  ]
}
